@@ -0,0 +1,32 @@
+#!/usr/bin/env python
+# Seed script to populate the DB with default personas
+
+from app import create_app, db
+from app.models import Persona
+
+app = create_app()
+
+with app.app_context():
+    db.create_all()
+    existing = Persona.query.filter_by(name='default').first()
+    if not existing:
+        p = Persona(name='default', description='A helpful humanoid AI orchestrator', tone='friendly', metadata={})
+        db.session.add(p)
+        db.session.commit()
+        print('Seeded default persona')
+    else:
+        print('Default persona already exists')
+
