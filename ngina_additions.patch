@@ -0,0 +1,56 @@
+import pytest
+from app import create_app, db
+from app.models import Persona
+
+
+@pytest.fixture
+def app():
+    app = create_app()
+    app.config.update({
+        'TESTING': True,
+        'SQLALCHEMY_DATABASE_URI': 'sqlite:///:memory:'
+    })
+
+    with app.app_context():
+        db.create_all()
+        yield app
+        db.drop_all()
+
+
+@pytest.fixture
+def client(app):
+    return app.test_client()
+
+
+def test_health(client):
+    r = client.get('/health')
+    assert r.status_code == 200
+    assert r.get_json() == {'status': 'ok'}
+
+
+def test_persona_lifecycle(client):
+    # initially default fallback
+    r = client.get('/persona')
+    assert r.status_code == 200
+    data = r.get_json()
+    assert 'default' in data
+
+    # create a new persona
+    payload = {'name': 'alice', 'description': 'Test persona', 'tone': 'formal', 'metadata': {'age': 30}}
+    r = client.post('/persona', json=payload)
+    assert r.status_code == 200
+    j = r.get_json()
+    assert j.get('ok') is True
+    assert j.get('persona', {}).get('name') == 'alice'
+
+    # list personas
+    r = client.get('/persona')
+    data = r.get_json()
+    assert 'alice' in data
+
+
+def test_chat_echo(client):
+    payload = {'message': 'Hello world'}
+    r = client.post('/chat', json=payload)
+    assert r.status_code == 200
+    j = r.get_json()
+    assert 'response' in j
+
